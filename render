services:
  - type: web
    name: telegram-store-bot
    env: python
    region: oregon
    plan: free
    buildCommand: pip install -r requirements.txt
    startCommand: python bot.py
    envVars:
      - key: BOT_TOKEN
        sync: false
      - key: API_ID
        sync: false
      - key: API_HASH
        sync: false
      - key: MONGO_URI
        sync: false
      - key: DB_NAME
        value: telegram_store_bot
      - key: ADMIN_IDS
        sync: false
